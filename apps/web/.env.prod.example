# Production values live in the Dokploy environment panel, not in this repo.
# This file documents which variables the web service needs.
#
# NEXT_PUBLIC_* are inlined into the browser bundle at build time, so they are
# also passed as build args in docker-compose.yml. Changing one requires a rebuild.

AUTH_TRUST_HOST=true
AUTH_SECRET=
NEXTAUTH_URL=https://tamalawi.infi-tech.cloud
AUTH_URL=https://tamalawi.infi-tech.cloud

PORT=3019

NEXT_PUBLIC_API_ENDPOINT=https://api.tamalawi.infi-tech.cloud
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_NAME=tama
NEXT_PUBLIC_FACEBOOK_ACCESS_TOKEN=
