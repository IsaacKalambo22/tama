# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://<username>:<password>@localhost:5432/<databasename>?schema=public"
JWT_ACCESS_SECRET_KEY=your_jwt_secret_key
JWT_REFRESH_SECRET_KEY=your_jwt_secret_key

# InfiSend email integration
# API key for /v1/email/send and /v1/email/bulk (sk_test_… for sandbox, sk_live_… for production)
INFISEND_API_KEY=
# Webhook signing secret (whsec_…) — obtained when registering the webhook endpoint via the InfiSend dashboard
INFISEND_WEBHOOK_SECRET=
# Default sender display name passed per-send (shown in recipient's inbox)
INFISEND_DEFAULT_FROM_NAME=TAMA Farmers Trust
# Default reply-to address passed per-send
INFISEND_DEFAULT_REPLY_TO=
