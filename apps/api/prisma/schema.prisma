// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum EmailNotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  REJECTED
  CANCELLED
}

enum NotificationTargetType {
  INDIVIDUALS
  GROUP
  DISTRICT
  COUNCIL
}

enum NotificationBatchStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  password                   String?
  phoneNumber                String
  name                       String
  avatar                     String?
  district                   String?
  about                      String?
  role                       Role      @default(USER)
  lastLogin                  DateTime  @default(now())
  isVerified                 Boolean   @default(false)
  resetPasswordToken         String?
  resetPasswordExpiresAt     DateTime?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sentNotifications         InAppNotification[]    @relation("NotificationSender")
  receivedNotifications     InAppNotification[]    @relation("NotificationRecipient")
  notificationBatches       NotificationBatch[]    @relation("NotificationBatchSender")
  recipientGroupsCreated    RecipientGroup[]       @relation("RecipientGroupCreator")
  recipientGroupMemberships RecipientGroupMember[] @relation("RecipientGroupMember")
}

model Shop {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  address   String
  openHours String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportAndPublication {
  id        String   @id @default(uuid())
  fileUrl   String
  filename  String
  type      String
  extension String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Form {
  id        String   @id @default(uuid())
  fileUrl   String
  filename  String
  type      String
  extension String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  content   String
  imageUrl  String
  size      Int
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id              String  @id @default(uuid())
  name            String
  position        String
  imageUrl        String?
  facebookUrl     String?
  linkedInProfile String?
  twitterUrl      String?
  description     String
}

model Stat {
  id                  String   @id @default(uuid())
  registeredCustomers Float
  shops               Float
  councilors          Float
  cooperatives        Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model News {
  id          String   @id @default(uuid())
  title       String
  content     String
  imageUrl    String
  author      String
  readingTime Int
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CouncilList {
  id                        String   @id @default(uuid())
  demarcation               String
  councilArea               String
  imageUrl                  String?
  council                   String
  firstAlternateCouncillor  String
  secondAlternateCouncillor String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Event {
  id          String    @id @default(uuid())
  title       String // Event title
  description String // Event description
  location    String? // Event title
  date        DateTime // Start date of the event
  endDate     DateTime? // Optional end date of the event
  time        String? // Optional time of the event
  createdAt   DateTime  @default(now()) // Automatically set creation timestamp
  updatedAt   DateTime  @updatedAt // Automatically updated on modification
}

model Vacancy {
  id                  String   @id @default(uuid())
  title               String
  description         String
  company             String
  location            String
  status              String
  applicationDeadline DateTime
  salary              String?
  duties              String?
  qualifications      String?
  howToApply          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Carousel {
  id          String   @id @default(uuid())
  coverUrl    String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImageText {
  id          String   @id @default(uuid())
  heading     String
  description String
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailNotification {
  id            String                  @id @default(uuid())
  messageId     String?                 @unique
  event         String
  recipient     String
  templateId    String?
  subject       String?
  status        EmailNotificationStatus @default(QUEUED)
  failureCode   String?
  failureReason String?
  costCharged   String?
  providerMessageId String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([recipient])
  @@index([event])
  @@index([status])
}

// One row per (batch, recipient) so read state is tracked per person, even
// for a bulk send. `event` mirrors the shared vocabulary in
// apps/api/src/notifications/event-map.ts for system-triggered rows (e.g.
// "user.created"); it stays null for manually composed sends.
model InAppNotification {
  id          String   @id @default(uuid())
  batchId     String?
  batch       NotificationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  senderId    String?
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  body        String
  link        String?
  read        Boolean  @default(false)
  readAt      DateTime?
  event       String?
  createdAt   DateTime @default(now())

  @@index([recipientId, read, createdAt])
  @@index([batchId])
}

// Groups the fan-out for the sender's view ("sent to District X, 340
// recipients, 12 read"). `targetRef` holds the RecipientGroup id, the
// district string, or the CouncilList id depending on `targetType`;
// `individualIds` is used only when targetType is INDIVIDUALS.
model NotificationBatch {
  id            String                  @id @default(uuid())
  senderId      String
  sender        User                    @relation("NotificationBatchSender", fields: [senderId], references: [id], onDelete: Cascade)
  targetType    NotificationTargetType
  targetRef     String?
  individualIds String[]                @default([])
  title         String
  body          String
  link          String?
  scheduledFor  DateTime?
  status        NotificationBatchStatus @default(DRAFT)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  notifications InAppNotification[]

  @@index([senderId])
  @@index([status, scheduledFor])
}

// Reusable, named recipient lists a sender can target repeatedly instead of
// re-selecting individuals each time. No equivalent concept existed
// elsewhere in the schema.
model RecipientGroup {
  id        String                 @id @default(uuid())
  name      String
  createdBy String
  creator   User                   @relation("RecipientGroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members   RecipientGroupMember[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model RecipientGroupMember {
  id        String         @id @default(uuid())
  groupId   String
  group     RecipientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("RecipientGroupMember", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}
