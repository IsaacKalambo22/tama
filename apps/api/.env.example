# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tama?schema=public"

# Server
PORT=8000

# JWT
JWT_ACCESS_SECRET_KEY=your-jwt-access-secret-key-here
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret-key-here

# Client
CLIENT_BASE_URL=http://localhost:3000

# Domain
DOMAIN_NAME="Tama farmers Trust"
EMAIL_HOST=mail.example.com
DOMAIN_EMAIL=noreply@example.com

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here
ADMIN_PHONE_NUMBER=+264880000000

# InfiSend (email + SMS)
INFISEND_API_KEY=your-infisend-api-key-here
INFISEND_WEBHOOK_SECRET=your-infisend-webhook-secret-here
INFISEND_DEFAULT_FROM_NAME=TaMalawi
INFISEND_DEFAULT_REPLY_TO=noreply@tamalawi.com
# Optional: registered Africa's Talking sender ID; omit to use Infitech's default
INFISEND_DEFAULT_SENDER_ID=
